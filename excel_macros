Private Sub InsertLayerInEachWorksheet(strWorksheetName As String, intFirstRow As Integer)
Dim intLayersNumber As Integer
Dim dblRowNumber As Double
Dim intLayerCounter As Integer
Dim i As Integer
Dim strOriginalSampleID As String
Dim strLayersSampleID As String
Dim strLayersHomogenGroupID As String
Dim strLOriginalHomogenGroupID As String
Dim strClientID As String
Dim strOriginalClientID As String
Dim strSampleID
Dim lngLastSampleIDNumber As Long
Dim j As Integer
Dim arrSplitSampleID() As String
Dim intRowNumber As Integer

On Error GoTo EH:
    Sheets(strWorksheetName).Select
    Cells(intFirstRow, 3).Select
    strOriginalSampleID = ActiveCell.Offset(0, -1).Value
    Do Until ActiveCell.Value = ""
        Cells(intFirstRow, 3).Select
        intLayersNumber = ActiveCell.Value
        strOriginalSampleID = ActiveCell.Offset(0, -1).Value
        strLOriginalHomogenGroupID = ActiveCell.Offset(0, 1).Value
        strOriginalClientID = ActiveCell.Offset(0, -2).Value
        
        If ActiveCell.Value <> 1 Then
            intLayerCounter = 1
            ActiveCell.Value = intLayerCounter
            strClientID = strOriginalClientID & "." & intLayerCounter
            ActiveCell.Offset(0, -2).Value = strClientID
            If strLOriginalHomogenGroupID <> "" Then
                strLayersHomogenGroupID = strLOriginalHomogenGroupID & "." & intLayerCounter
            Else
                strLayersHomogenGroupID = strOriginalClientID & "." & intLayerCounter
            End If
            ActiveCell.Offset(0, 1).Value = strLayersHomogenGroupID
            
            For i = 1 To intLayersNumber - 1
                ActiveCell.EntireRow.Select
                Selection.Copy
                Selection.Insert Shift:=xlDown
                dblRowNumber = ActiveCell.Row
                Cells(dblRowNumber + 1, 3).Select
                intLayerCounter = intLayerCounter + 1
                ActiveCell.Value = intLayerCounter
                
                strClientID = strOriginalClientID & "." & intLayerCounter
                ActiveCell.Offset(0, -2).Value = strClientID
                If strLOriginalHomogenGroupID <> "" Then
                    strLayersHomogenGroupID = strLOriginalHomogenGroupID & "." & intLayerCounter
                Else
                    strLayersHomogenGroupID = strOriginalClientID & "." & intLayerCounter
                End If
                ActiveCell.Offset(0, 1).Value = strLayersHomogenGroupID
                
            Next
            intFirstRow = intFirstRow + intLayersNumber
        Else
            intFirstRow = intFirstRow + 1
        End If
        Cells(intFirstRow, 3).Select
    Loop
    j = 8
    Cells(j, 1).Select
    strSampleID = ActiveCell.Offset(0, 1).Value
    Do Until ActiveCell.Value = ""
        intRowNumber = ActiveCell.Row - 7
        strSampleID = Left(strSampleID, 10) & Str(intRowNumber)
        ActiveCell.Offset(0, 1).Value = strSampleID
        j = j + 1
        Cells(j, 1).Select
    Loop
    Sheets("DataEntry").Select
    
Exit Sub
EH: MsgBox "Error # " & Str(Err.Number) & " was generated by " _
            & Err.Source & Chr(13) & Err.Description & " during InsertLayerInEachWorksheet"
End Sub

Private Sub ClearND()
Dim i As Integer
Dim j As Integer
Dim SetRange As String

    Sheets("SampleAnalyses").Select
    i = 8
    SetRange = "W" & i
