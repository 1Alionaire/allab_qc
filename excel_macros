Public Sub CopySamples()
Dim SetRange As String
Dim strOriginalRange As String
Dim strDestinationRangeSampleAnalyses As String
Dim strDestinationRangeNOB_Calculation As String
Dim strDestinationRangeTEM_Calculation As String
 
Dim i As Integer    'For "DataEntry" Worksheet, i = 8
Dim j As Integer    'For "NOB_Calculation" Worksheet, j = 7
Dim k As Integer    'For "TEM_Calculation" Worksheet, k = 6
Dim z As Integer    'For "SampleAnalyses" Worksheet, z = 8
Dim MessageResponse
Dim strMethodID As String
Dim intRowCounter As Integer
On Error GoTo EH:

    Application.ScreenUpdating = False
    MessageResponse = MsgBox("Do you want to populate? All results for PLM will be lost.", vbYesNo, "Populate")
    If MessageResponse = vbNo Then
        Exit Sub
    End If
    intRowCounter = CountRows("DataEntry", 8)
    
    Sheets("DataEntry").Select
    i = 8
    j = 7
    k = 6
    z = 8
    Range("A8").Select
    Do Until ActiveCell.Value = ""
        Sheets("DataEntry").Select
        SetRange = "A" & i
        Range(SetRange).Select
        strMethodID = ActiveCell.Offset(0, 6).Value
        strOriginalRange = "A" & i & ":C" & i
        strDestinationRangeSampleAnalyses = "A" & z & ":C" & z
        strDestinationRangeNOB_Calculation = "A" & j & ":C" & j
        strDestinationRangeTEM_Calculation = "A" & k & ":C" & k
        
        Select Case strMethodID
            Case "198.1", "NJ-F", "EPA 600"
                Call CopyPasteRange("DataEntry", strOriginalRange, "SampleAnalyses", strDestinationRangeSampleAnalyses)
                z = z + 1
            Case "198.4", "NJ-TEM"
                Call CopyPasteRange("DataEntry", strOriginalRange, "TEM_Calculation", strDestinationRangeTEM_Calculation)
                k = k + 1
                Call CopyPasteRange("DataEntry", strOriginalRange, "NOB_Calculation", strDestinationRangeNOB_Calculation)
                j = j + 1
            Case "198.6", "NJ-NOB"
                Call CopyPasteRange("DataEntry", strOriginalRange, "SampleAnalyses", strDestinationRangeSampleAnalyses)
                z = z + 1
                Call CopyPasteRange("DataEntry", strOriginalRange, "NOB_Calculation", strDestinationRangeNOB_Calculation)
                j = j + 1
                Call CopyPasteRange("DataEntry", strOriginalRange, "TEM_Calculation", strDestinationRangeTEM_Calculation)
                k = k + 1
        End Select
        i = i + 1
    Loop
    'Call PopulateNAD
   
    Call InsertMethod("SampleAnalyses", 8, 42)
    Call InsertMethod("NOB_Calculation", 7, 13)
    Call InsertMethod("TEM_Calculation", 6, 16)
    
    Call PopulateHomogenityGroupOnAllSheets("SampleAnalyses", 8, 4)
    Call PopulateHomogenityGroupOnAllSheets("NOB_Calculation", 7, 14)
    Call PopulateHomogenityGroupOnAllSheets("TEM_Calculation", 6, 2)
    
    MsgBox "Copy samples completed"
    SetRange = ""
    strOriginalRange = ""
    
    strDestinationRangeSampleAnalyses = ""
    strDestinationRangeNOB_Calculation = ""
    strDestinationRangeTEM_Calculation = ""
    Application.ScreenUpdating = True
Exit Sub
EH: MsgBox "Error # " & Str(Err.Number) & " was generated by " _
            & Err.Source & Chr(13) & Err.Description & " during CopySamples procedure"
End Sub
Private Function CountRows(strWorksheet As String, intRowNumber As Integer) As Integer
Dim lastRow As Integer
Dim wsSrc As Worksheet: Set wsSrc = Worksheets(strWorksheet)
Dim RowCounter As Integer
RowCounter = 0
Dim i As Integer
    On Error GoTo EH:
    i = intRowNumber
    Do Until wsSrc.Cells(i, 2) = ""
        If wsSrc.Cells(i, 2) <> "" Then
            RowCounter = RowCounter + 1
            i = i + 1
        End If
        Cells(i, 2).Select
    Loop
    CountRows = RowCounter
Exit Function
EH: MsgBox "Error # " & Str(Err.Number) & " was generated by " _
            & Err.Source & Chr(13) & Err.Description & " during CountRows procedure"
End Function

Private Sub CalculateFriableResults()
Dim colAsbestosType As New Collection
Dim i As Integer
Dim strSampleNumber As String
Dim strAsbestosType As String
Dim IsFirstAsbestosType As Boolean
Dim k As Integer
Dim TotalAsbestosPoint As Double
Dim TotalAsbestosTypePoint As Double
Dim AsbestosTypePercent As Double
Dim dblTotalAsbestos As Double
Dim NonAsbestos As Double
Dim FirstPercentOccurance As Long
Dim dblPercentNonAsbestos As String
Dim dblPercentNOB As Double
Dim strOtherFibers As String
Dim dblTotalOtherFiber As Double
Dim dblOtherFibers As Double
Dim strMethodID As String
Dim strNADorPS As String
Dim g
Dim arrSplitStrings() As String
Dim strSingleString As String

Dim strSingleStringTotal As String
Dim z As Long

Dim dblTotalAsbestosEPA600 As Double
Dim dblTotalAsbestos_EPA As Double
Dim dblTotalAsbestosEPA600_TypeFirst As Double
Dim dblTotalAsbestosEPA600_TypeSecond As Double
Dim colAsbestosType_EPA600 As New Collection
Dim strAsbestosTypeEPA600 As String
Dim h
Dim l As Integer

On Error GoTo EH:
    Application.ScreenUpdating = False
    i = 8
    Sheets("SampleAnalyses").Select
    Range("B8").Select
    Do Until Cells(i, 2) = ""
        'Clear contents of the cells in row i and column AM - AP
        ActiveCell.Offset(0, 37).Select
        For k = 1 To 4
            ActiveCell.Value = ""
            ActiveCell.Offset(0, 1).Select
        Next
        
        Cells(i, 2).Select
        'Sample id
        strSampleNumber = ActiveCell.Value
        'Determine Method ID
        strMethodID = ActiveCell.Offset(0, 42).Value
        If strMethodID <> "EPA 600" Then
            TotalAsbestosPoint = 0
            ActiveCell.Offset(0, 21).Select
            'Calculate TotalAsbestosPoint for each sample
            '12
            Do Until ActiveCell.Value = ""
                If ActiveCell.Value <> "NAD" And ActiveCell.Value <> "PS" Then
                    TotalAsbestosPoint = TotalAsbestosPoint + ActiveCell.Offset(0, 1).Value
                    On Error Resume Next
                    colAsbestosType.Add ActiveCell.Value, CStr(ActiveCell.Value)
                    On Error GoTo 0
                Else
                    TotalAsbestosPoint = TotalAsbestosPoint + 50
                End If
                ActiveCell.Offset(0, 2).Select
            Loop
            '-------------------------
            IsFirstAsbestosType = False
            '--------------------------
            If colAsbestosType.Count >= 1 Then
        
                For Each g In colAsbestosType
                    'Calculate TotalAsbestosPoints for each type of asbestos
                    TotalAsbestosTypePoint = 0
                    strAsbestosType = colAsbestosType.Item(g)
                    k = 23
                    Cells(i, k).Select
                    Do Until ActiveCell.Value = ""
                        If colAsbestosType.Item(g) = ActiveCell.Value Then
                            TotalAsbestosTypePoint = TotalAsbestosTypePoint + 1
                            k = k + 2
                            Cells(i, k).Select
                        Else
                            k = k + 2
                            Cells(i, k).Select
                        End If
                    Loop
                    'Populate type of asbestos and amount of asbestos in cells AL - AO
            
                    If IsFirstAsbestosType = False Then
                        Cells(i, 39).Select
                        ActiveCell.Value = colAsbestosType.Item(g)
                        AsbestosTypePercent = TotalAsbestosTypePoint / TotalAsbestosPoint * 100

                        If strMethodID = "198.6" Or strMethodID = "198.4" Then
                            dblPercentNOB = CalculatePercentNOB(strSampleNumber)
                            AsbestosTypePercent = AsbestosTypePercent * dblPercentNOB / 100
                        End If

                        Sheets("SampleAnalyses").Select
                        Cells(i, 39).Select
                        ActiveCell.Offset(0, 1).Select
                        ActiveCell.Value = Format(AsbestosTypePercent, "###0.00")
                        dblTotalAsbestos = Format(AsbestosTypePercent, "###0.00")
                    Else
                        Cells(i, 41).Select
                        ActiveCell.Value = colAsbestosType.Item(g)
                        AsbestosTypePercent = TotalAsbestosTypePoint / TotalAsbestosPoint * 100
                
                        If strMethodID = "198.6" Or strMethodID = "198.4" Then
                            dblPercentNOB = CalculatePercentNOB(strSampleNumber)
                            AsbestosTypePercent = AsbestosTypePercent * dblPercentNOB / 100
                        End If
              
                        Sheets("SampleAnalyses").Select
                        Cells(i, 41).Select
                        ActiveCell.Offset(0, 1).Select
                        ActiveCell.Value = Format(AsbestosTypePercent, "###0.00")
                        dblTotalAsbestos = dblTotalAsbestos + AsbestosTypePercent
                    End If
            
                    IsFirstAsbestosType = True
                Next g
        
            Else
                Cells(i, 23).Select
                strNADorPS = ActiveCell.Value
                Cells(i, 39).Select
                ActiveCell.Value = strNADorPS
                Cells(i, 40).Select
                ActiveCell.Value = strNADorPS
                '---Insert ND  in vermiculite column if Type # 1  = "PS"
                If strNADorPS <> "PS" Then
                    Cells(i, 43).Select
                    ActiveCell.Value = "ND"
                End If
            End If
        'For EPA 600
        Else
            ActiveCell.Offset(0, 45).Select
            'Populate collection type for EPA 600 - Find out how many different type of asbestos are in all slides
            Do Until ActiveCell.Value = ""
                'If ActiveCell.Value <> "NAD" And ActiveCell.Value <> "PS" Then
                    On Error Resume Next
                    colAsbestosType_EPA600.Add ActiveCell.Value, CStr(ActiveCell.Value)
                    On Error GoTo 0
                    ActiveCell.Offset(0, 2).Select
                'Else
                    'ActiveCell.Offset(0, 2).Select
                'End If
            Loop
            IsFirstAsbestosType = False
            If colAsbestosType_EPA600.Count >= 1 Then
                For Each h In colAsbestosType_EPA600
                    'Calculate TotalAsbestosPoints for each type of asbestos
                    strAsbestosTypeEPA600 = colAsbestosType_EPA600.Item(h)
                    l = 47
                    Cells(i, l).Select
                    dblTotalAsbestosEPA600 = 0
                    Do Until ActiveCell.Value = ""
                        If ActiveCell.Value <> "NAD" Then
                            If colAsbestosType_EPA600.Item(h) = ActiveCell.Value Then
                                dblTotalAsbestosEPA600 = dblTotalAsbestosEPA600 + ActiveCell.Offset(0, 1).Value
                                l = l + 2
                                Cells(i, l).Select
                            Else
                                l = l + 2
                                Cells(i, l).Select
                            End If
                        Else
                            l = l + 2
                            Cells(i, l).Select
                        End If
                    Loop
                    'dblTotalAsbestosEPA600_TypeFirst = dblTotalAsbestosEPA600
                    If IsFirstAsbestosType = False Then
                        Cells(i, 79).Select
                        ActiveCell.Value = colAsbestosType_EPA600.Item(h)
                        Cells(i, 80).Select
                        ActiveCell.Value = dblTotalAsbestosEPA600 / 4
                        dblTotalAsbestosEPA600_TypeFirst = ActiveCell.Value
                    Else
                        Cells(i, 81).Select
                        ActiveCell.Value = colAsbestosType_EPA600.Item(h)
                        Cells(i, 82).Select
                        ActiveCell.Value = dblTotalAsbestosEPA600 / 4
                        dblTotalAsbestosEPA600_TypeSecond = ActiveCell.Value
                    End If
                    IsFirstAsbestosType = True
                Next h
                Set colAsbestosType_EPA600 = Nothing
            End If
        End If
        dblTotalAsbestos_EPA = dblTotalAsbestosEPA600_TypeFirst + dblTotalAsbestosEPA600_TypeSecond
        Cells(i, 83).Select
        ActiveCell.Value = dblTotalAsbestos_EPA
        dblTotalAsbestosEPA600_TypeFirst = 0
        dblTotalAsbestosEPA600_TypeSecond = 0
        '-------------------------------------------------------------
        'Calculate % other fiber
        dblOtherFibers = 0
        Cells(i, 20).Select
        
        If ActiveCell.Value = "" Then
            dblOtherFibers = 0
        Else
            strSingleStringTotal = ActiveCell.Value
            arrSplitStrings = Split(strSingleStringTotal, "-")
            If IsEmpty(arrSplitStrings) = False Then
                For z = LBound(arrSplitStrings) To UBound(arrSplitStrings)
                    If InStr(arrSplitStrings(z), "%") > 0 Then
                        strSingleString = arrSplitStrings(z)
                        FirstPercentOccurance = InStr(strSingleString, "%")
                        dblOtherFibers = dblOtherFibers + CDbl(Trim(Left(strSingleString, (FirstPercentOccurance - 1))))
                    Else
                        MsgBox "No % in other fibers"
                    End If
                Next z
            Else
                MsgBox "No other fibers"
            End If
        End If
        '----------------
        If strMethodID = "EPA 600" Then
            dblPercentNonAsbestos = 100 - dblOtherFibers - dblTotalAsbestos_EPA
        Else
            dblPercentNonAsbestos = 100 - dblOtherFibers - dblTotalAsbestos
        End If
        ActiveCell.Offset(0, 2).Value = Format(dblPercentNonAsbestos, "###0.00")
        dblTotalAsbestos = 0
        Set colAsbestosType = Nothing
        
        i = i + 1
        Cells(i, 2).Select
    Loop
    dblOtherFibers = 0
    Application.ScreenUpdating = True
    Exit Sub
EH: MsgBox "Error # " & Str(Err.Number) & " was generated by " _
            & Err.Source & Chr(13) & Err.Description & " during CalculateFriableResult procedure"
End Sub
