Public Function GetTEMAsbestosPercentageAndType(strSampleID As String, strWorksheet As String, strRange As String) As String
Dim i As Integer
Dim SetRangeSampleAnalyses As String
    
    On Error GoTo EH:
    Sheets(strWorksheet).Select
    Range("B6").Select
    i = 6
    Do Until ActiveCell.Value = ""
        If ActiveCell.Value = strSampleID Then
            If ActiveCell.Offset(0, 5).Value <> "" Then
                If ActiveCell.Offset(0, 5).Value <> "NAD" And ActiveCell.Offset(0, 5).Value <> "PS" Then
                    If ActiveCell.Offset(0, 5).Value > 1 Then
                        GetTEMAsbestosPercentageAndType = ROUNDSIG(ActiveCell.Offset(0, 5).Value, 2) & "% " & ActiveCell.Offset(0, 6).Value
                    Else
                        GetTEMAsbestosPercentageAndType = "Trace " & ActiveCell.Offset(0, 6).Value
                    End If
                    
                    If ActiveCell.Offset(0, 8).Value <> "NAD" And ActiveCell.Offset(0, 8).Value <> 0 Then
                       If ActiveCell.Offset(0, 8).Value > 1 Then
                            GetTEMAsbestosPercentageAndType = GetTEMAsbestosPercentageAndType & "," & vbNewLine & ROUNDSIG(ActiveCell.Offset(0, 8).Value, 2) & "% " & ActiveCell.Offset(0, 9).Value
                       Else
                            GetTEMAsbestosPercentageAndType = GetTEMAsbestosPercentageAndType & "," & vbNewLine & "Trace " & ActiveCell.Offset(0, 9).Value
                       End If
                    End If
                Else
                    If ActiveCell.Offset(0, 5).Value = "NAD" Then
                        GetTEMAsbestosPercentageAndType = "NAD"
                    Else
                        GetTEMAsbestosPercentageAndType = "Not Analyzed"
                    End If
                End If
            End If
           
        End If
        
        i = i + 1
        SetRangeSampleAnalyses = "B" & i
        Range(SetRangeSampleAnalyses).Select
    Loop
    Sheets(strWorksheet).Select
    Range(strRange).Select
    
    SetRangeSampleAnalyses = ""
Exit Function
