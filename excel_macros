Public Sub CalculateNOBResults()
Dim strSampleID As String
Dim dblCrusibleWeight As Double
Dim dblSampleAndCrusibleWeight As Double
Dim dblSampleWeight As Double
Dim dblSampleAndCrusibleAfterAshing As Double
Dim dblPercentOrganic As Double
Dim dblPetryDishAndFilter As Double
Dim dblPetryDishAndFilterAndSampleFirst As Double
Dim dblPetryDishAndFilterAndSampleSecond As Double
Dim dblPercentWeightDifference As Double
Dim dblPercentCaCO3 As Double
Dim dblPercentTotalResidue As Double
Dim SetRange As String
Dim i As Integer
On Error GoTo EH:
    Application.ScreenUpdating = False
    'Check if weight is not 0
'    If CheckColumnContentForZero("NOB_Calculation", 7, 4) = False Then
        Sheets("NOB_Calculation").Select
        i = 7
        SetRange = "B" & i
        Range(SetRange).Select
        Do Until ActiveCell.Value = ""
            strSampleID = ActiveCell.Value
            dblCrusibleWeight = ActiveCell.Offset(0, 2)
            dblSampleAndCrusibleWeight = ActiveCell.Offset(0, 3)
            dblSampleWeight = dblSampleAndCrusibleWeight - dblCrusibleWeight
            dblSampleAndCrusibleAfterAshing = ActiveCell.Offset(0, 5)
            If dblSampleWeight <> 0 Then
                dblPercentOrganic = (dblSampleWeight - (dblSampleAndCrusibleAfterAshing - dblCrusibleWeight)) / dblSampleWeight * 100
                dblPetryDishAndFilter = ActiveCell.Offset(0, 7)
                dblPetryDishAndFilterAndSampleFirst = ActiveCell.Offset(0, 8)
                dblPetryDishAndFilterAndSampleSecond = ActiveCell.Offset(0, 9)
                dblPercentWeightDifference = Abs(dblPetryDishAndFilterAndSampleFirst - dblPetryDishAndFilterAndSampleSecond) / dblPetryDishAndFilterAndSampleFirst * 100
                dblPercentTotalResidue = Format((dblPetryDishAndFilterAndSampleSecond - dblPetryDishAndFilter) / dblSampleWeight * 100, "###0.00")
                dblPercentCaCO3 = 100 - dblPercentOrganic - dblPercentTotalResidue
                ActiveCell.Offset(0, 4).Value = dblSampleWeight
                ActiveCell.Offset(0, 6).Value = Format(dblPercentOrganic, "###0.00")
                ActiveCell.Offset(0, 10).Value = Format(dblPercentWeightDifference, "###0.00")
                ActiveCell.Offset(0, 11).Value = Format(dblPercentCaCO3, "###0.00")
                ActiveCell.Offset(0, 12).Value = Format(dblPercentTotalResidue, "###0.00")
        
                'Add % Residue to SampleAnalyses Sheet
                Call PopulateSheetWithTotalResidue("SampleAnalyses", strSampleID, dblPercentTotalResidue, 8, 44)
                'Add % Residue to TEM_Calculation Sheet
                Call PopulateSheetWithTotalResidue("TEM_Calculation", strSampleID, dblPercentTotalResidue, 6, 3)
                i = i + 1
                SetRange = "B" & i
                Range(SetRange).Select
            Else
                i = i + 1
                SetRange = "B" & i
                Range(SetRange).Select
            End If
            
        Loop
    'Populate Visual Estimation, %asbestosand AsbestosType columns on TEM_Calculation sheet with NAD
        Call PopulateVisualEstimationColumnWithNAD
'    Else
'        MsgBox "Weight of the crusible is 0. Please check"
'    End If
    Application.ScreenUpdating = True
Exit Sub
EH: MsgBox "Error # " & Str(Err.Number) & " was generated by " _
            & Err.Source & Chr(13) & Err.Description & " during CalculateNOBResults procedure"
End Sub

Public Sub CalculateTEMResults()
Dim dblPercentTotalResidue As Double
Dim dblPercentTotalTEMAsbestos As Double
Dim dblPercentTotalTEMAsbestos_Second As Double
Dim dblVisualEstimation As Double
Dim dblVisualEstimation_Second As Double

Dim strSampleID As String
Dim i As Integer
Dim j As Integer
Dim SetRangeTEM As String

On Error GoTo EH:
    Application.ScreenUpdating = False
    i = 6
    Sheets("TEM_Calculation").Select
    SetRangeTEM = "B" & i
    Range(SetRangeTEM).Select
    Do Until ActiveCell.Value = ""
        strSampleID = ActiveCell.Value
        '''''''''''''''''''''' Added
        If ActiveCell.Offset(0, 4).Value <> "NAD" Then
            If ActiveCell.Offset(0, 4).Value <> "PS" Then
                dblVisualEstimation = ActiveCell.Offset(0, 4).Value
                dblPercentTotalResidue = ActiveCell.Offset(0, 3).Value
                dblPercentTotalTEMAsbestos = dblPercentTotalResidue * dblVisualEstimation / 100
                ActiveCell.Offset(0, 5).Value = Format(dblPercentTotalTEMAsbestos, "###0.00")
            Else
                ActiveCell.Offset(0, 17).Value = "PS"
                ActiveCell.Offset(0, 5).Value = "PS"
            End If
        Else
            ActiveCell.Offset(0, 5).Value = "NAD"
        End If
        
        If ActiveCell.Offset(0, 7).Value <> "NAD" And ActiveCell.Offset(0, 7).Value <> "" Then
            dblVisualEstimation_Second = ActiveCell.Offset(0, 7).Value
            dblPercentTotalResidue = ActiveCell.Offset(0, 3).Value
            dblPercentTotalTEMAsbestos_Second = dblPercentTotalResidue * dblVisualEstimation_Second / 100
            ActiveCell.Offset(0, 8).Value = Format(dblPercentTotalTEMAsbestos_Second, "###0.00")
        End If
    
        ''''''''''''''''''''''''''''''''''
        i = i + 1
        SetRangeTEM = "B" & i
        Range(SetRangeTEM).Select
    Loop
    Application.ScreenUpdating = True
Exit Sub
EH: MsgBox "Error # " & Str(Err.Number) & " was generated by " _
            & Err.Source & Chr(13) & Err.Description & " during CalculateTEMResults procedure"
End Sub

