Public Sub InsertLayers()
Dim i As Integer
Dim j As Integer
Dim intLayersNumber As Integer
Dim Worksheets As Worksheet

On Error GoTo EH:

    For i = 1 To 4
        Sheets(i).Select
        Select Case ActiveWorkbook.Worksheets(i).Name
            Case "DataEntry"
                Call InsertLayerInEachWorksheet(ActiveWorkbook.Worksheets(i).Name, 8)
            Case "SampleAnalyses"
                Call InsertLayerInEachWorksheet(ActiveWorkbook.Worksheets(i).Name, 8)
            Case "NOB_Calculation"
                Call InsertLayerInEachWorksheet(ActiveWorkbook.Worksheets(i).Name, 7)
            Case "TEM_Calculation"
                Call InsertLayerInEachWorksheet(ActiveWorkbook.Worksheets(i).Name, 6)
            Case "PLM_TEM_Report"
                Call InsertLayerInEachWorksheet(ActiveWorkbook.Worksheets(i).Name, 6)
        End Select
    Next
Exit Sub
EH: MsgBox "Error # " & Str(Err.Number) & " was generated by " _
            & Err.Source & Chr(13) & Err.Description & " during InsertLayers procedure"
End Sub

Public Sub PopulateSheetWithTotalResidue(strSheetName As String, strSampleID As String, dblPercentTotalResidue As Double, intRowNumber As Integer, intOffsetNumber As Integer)
