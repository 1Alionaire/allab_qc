Private Function ROUNDSIG(Num As Double, sigs As Double) As Double
    Dim exponent As Double
'    Dim Num As Double
'    Num = CDbl(strNum)
    If IsNumeric(Num) And IsNumeric(sigs) Then
        If sigs < 1 Then
            ' Return the  " #NUM "  error
            ROUNDSIG = CVErr(xlErrNum)
        Else
            If Num <> 0 Then
                exponent = Int(Log(Abs(Num)) / Log(10#))
            Else
                exponent = 0
            End If
            ROUNDSIG = WorksheetFunction.Round(Num, _
                       sigs - (1 + exponent))
        End If
    Else
        ' Return the  " #N/A "  error
        ROUNDSIG = CVErr(xlErrNA)
    End If
End Function


Function SortCollection(cCollection As Collection) As Date
Dim vItm As Date
Dim i As Long, j As Long
Dim vTemp As Date

   'Two loops to bubble sort
    For i = 1 To cCollection.Count - 1
        For j = i + 1 To cCollection.Count
            If cCollection(i) > cCollection(j) Then
                'store the greatest item
                vTemp = cCollection(i)
                'remove the lesser item
                cCollection.Remove j
                're-add the greater item before the
                'lesser Item
                cCollection.Add vTemp  ', vTemp, i
            End If
        Next j
    Next i
    
    SortCollection = cCollection.Item(i)
End Function

